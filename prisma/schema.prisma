// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  password      String?

  image         String?
  provider      String

  emailVerified Boolean  @default(false)

  otp           String?
  otpExpiry     DateTime?

  resetToken    String?
  resetExpiry   DateTime?

  isOnline Boolean @default(false)
  lastSeen DateTime?

  messages Message[]
  chats   ChatMember[]

  // ── Room invite relations (additive) ─────────────────────────────
  sentInvites     RoomInvite[] @relation("SentInvites")
  receivedInvites RoomInvite[] @relation("ReceivedInvites")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Chat {
  id String @id @default(cuid())
  name String? 
  isGroup Boolean @default(false)

  // ── Room fields (additive) ────────────────────────────────────────
  isRoom         Boolean  @default(false)
  roomCode       String?  @unique
  roomCodeActive Boolean  @default(true)

  members    ChatMember[]
  messages   Message[]
  roomInvites RoomInvite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatMember {
  id String @id @default(cuid())

  userId String
  chatId String
  role ChatMemberRole @default(MEMBER)
  canSend Boolean @default(false)
  lastReadAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  chat Chat @relation(fields: [chatId], references: [id])

  @@unique([userId, chatId])
}

enum ChatMemberRole {
  CREATOR
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  FILE
}

model Message {
  id String @id @default(cuid())
  content String?

  type MessageType @default(TEXT)

  fileUrl String?
  fileName String?
  fileType String?
  fileSize Int?

  senderId String
  chatId String

  sender User @relation(fields: [senderId], references: [id])
  chat Chat @relation(fields: [chatId], references: [id])

  createdAt DateTime @default(now())
}

// ── Room Invite ────────────────────────────────────────────────────
model RoomInvite {
  id            String       @id @default(cuid())
  chatId        String
  chat          Chat         @relation(fields: [chatId], references: [id], onDelete: Cascade)
  invitedById   String
  invitedBy     User         @relation("SentInvites", fields: [invitedById], references: [id])
  invitedUserId String
  invitedUser   User         @relation("ReceivedInvites", fields: [invitedUserId], references: [id])
  status        InviteStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  respondedAt   DateTime?

  @@unique([chatId, invitedUserId, status])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
}
