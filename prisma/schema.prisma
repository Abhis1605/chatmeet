// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(cuid())
  name     String?
  email    String  @unique
  password String?

  image    String?
  provider String

  emailVerified Boolean @default(false)

  otp       String?
  otpExpiry DateTime?

  resetToken  String?
  resetExpiry DateTime?

  // Logins issued before this time are rejected (set on password reset/change)
  passwordChangedAt DateTime?

  isOnline Boolean   @default(false)
  lastSeen DateTime?

  // ── Profile (additive) ────────────────────────────────────────────
  username         String?          @unique
  bio              String?
  profilePhotoType ProfilePhotoType @default(PHOTO)
  avatarFilename   String?
  statusPreference StatusPreference @default(ONLINE)
  showLastSeen     Boolean          @default(true)
  showOnlineStatus Boolean          @default(true)

  // ── Settings (additive) ───────────────────────────────────────────
  theme               ThemePreference @default(SYSTEM)
  enterToSend         Boolean         @default(true)
  readReceiptsEnabled Boolean         @default(true)
  showTypingIndicator Boolean         @default(true)
  notificationSound   Boolean         @default(true)
  notificationToast   Boolean         @default(true)
  notificationsMuted  Boolean         @default(false)
  deletedAt           DateTime?

  messages Message[]
  chats    ChatMember[]

  // ── Reactions & mentions (additive) ───────────────────────────────
  messageReactions MessageReaction[]
  messageMentions  MessageMention[]

  // ── Room invite relations (additive) ─────────────────────────────
  sentInvites     RoomInvite[] @relation("SentInvites")
  receivedInvites RoomInvite[] @relation("ReceivedInvites")

  // ── Video call relations (additive) ──────────────────────────────
  startedCalls       CallSession[]
  callParticipations CallParticipant[]

  // ── Blocked users (additive) ──────────────────────────────────────
  blockedUsers BlockedUser[] @relation("Blocker")
  blockedBy    BlockedUser[] @relation("Blocked")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Blocked users (additive) ────────────────────────────────────────
model BlockedUser {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model Chat {
  id      String  @id @default(cuid())
  name    String?
  image   String?
  isGroup Boolean @default(false)

  // ── Room fields (additive) ────────────────────────────────────────
  isRoom         Boolean @default(false)
  roomCode       String? @unique
  roomCodeActive Boolean @default(true)

  members     ChatMember[]
  messages    Message[]
  roomInvites RoomInvite[]

  // ── Video call relations (additive) ──────────────────────────────
  callSessions CallSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatMember {
  id String @id @default(cuid())

  userId     String
  chatId     String
  role       ChatMemberRole @default(MEMBER)
  canSend    Boolean        @default(false)
  lastReadAt DateTime       @default(now())

  // ── Per-chat inbox preferences (additive) ─────────────────────────
  archivedAt      DateTime?
  mutedUntil      DateTime?
  lastDeliveredAt DateTime?

  user User @relation(fields: [userId], references: [id])
  chat Chat @relation(fields: [chatId], references: [id])

  @@unique([userId, chatId])
}

enum ChatMemberRole {
  CREATOR
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
}

model Message {
  id      String  @id @default(cuid())
  content String?

  type MessageType @default(TEXT)

  fileUrl  String?
  fileName String?
  fileType String?
  fileSize Int?

  senderId String
  chatId   String

  // Threaded replies: every reply points at a top-level message so threads
  // stay two levels deep (slack-style) instead of nesting indefinitely.
  parentId String?
  parent   Message?  @relation("MessageThread", fields: [parentId], references: [id], onDelete: SetNull)
  replies  Message[] @relation("MessageThread")

  // ── Pins / forwards / previews / mentions (additive) ──────────────
  pinnedAt    DateTime?
  pinnedById  String?

  forwardedFromId String?
  forwardedFrom   Message?  @relation("ForwardedMessages", fields: [forwardedFromId], references: [id], onDelete: SetNull)
  forwardedTo     Message[] @relation("ForwardedMessages")

  // Cached OpenGraph preview for the first URL in a text message.
  linkPreview Json?

  mentions MessageMention[]
  reactions MessageReaction[]

  sender User @relation(fields: [senderId], references: [id])
  chat   Chat @relation(fields: [chatId], references: [id])

  createdAt DateTime @default(now())

  @@index([parentId])
  @@index([chatId, pinnedAt])
  @@index([forwardedFromId])
}

// ── Emoji reactions (additive) ──────────────────────────────────────
model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// ── Parsed @mentions (additive) ─────────────────────────────────────
model MessageMention {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId, createdAt])
}

// ── Video Call (additive) ─────────────────────────────────────────
model CallSession {
  id          String    @id @default(cuid())
  chatId      String
  chat        Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  hmsRoomId   String
  status      String    @default("ACTIVE")
  startedById String
  startedBy   User      @relation(fields: [startedById], references: [id])
  startedAt   DateTime  @default(now())
  endedAt     DateTime?

  // ── Call history / participants (additive) ───────────────────────
  type         String            @default("ONE_TO_ONE")
  mediaType    String            @default("VIDEO")
  participants CallParticipant[]

  @@index([chatId, status])
  @@index([startedAt, id])
}

// ── Call Participant (additive) ─────────────────────────────────────
model CallParticipant {
  id            String      @id @default(cuid())
  callSessionId String
  callSession   CallSession @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  status        String      @default("INVITED")
  joinedAt      DateTime?
  leftAt        DateTime?

  @@unique([callSessionId, userId])
  @@index([userId, status])
}

// ── Room Invite ────────────────────────────────────────────────────
model RoomInvite {
  id            String       @id @default(cuid())
  // Unguessable token used by the emailed invite link.
  token         String       @unique @default(cuid())
  chatId        String
  chat          Chat         @relation(fields: [chatId], references: [id], onDelete: Cascade)
  invitedById   String
  invitedBy     User         @relation("SentInvites", fields: [invitedById], references: [id])
  // Either an existing user, an email address, or both (email that belongs
  // to a registered user gets both so it also appears in their in-app list).
  invitedUserId String?
  invitedUser   User?        @relation("ReceivedInvites", fields: [invitedUserId], references: [id])
  invitedEmail  String?
  status        InviteStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  expiresAt     DateTime?
  respondedAt   DateTime?

  @@unique([chatId, invitedUserId, status])
  @@index([invitedEmail])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// ── Profile (additive) ─────────────────────────────────────────────
enum ProfilePhotoType {
  PHOTO
  AVATAR
}

enum StatusPreference {
  ONLINE
  AWAY
  DND
  INVISIBLE
}

// ── Settings (additive) ─────────────────────────────────────────────
enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}
